# Copier en .env puis compléter.

APP_ENV=development
CORS_ORIGINS=["http://localhost:5176"]
# Hôtes acceptés par l'API en plus de 127.0.0.1, localhost et [::1] (docs/SUITE.md §5.1), séparés par des virgules.
ALLOWED_HOSTS=

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# --- Claude ---
# cli : via la CLI Claude Code (`claude -p`, lancée isolée et sans outils), facturé sur votre abonnement claude.ai.
#       Prérequis : Claude Code installé et `claude auth login` fait avec votre compte claude.ai.
# api : via l'API Anthropic, avec une clé de la Console Claude (facturation API séparée).
CLAUDE_MODE=cli

# Mode cli — exécutable : chemin absolu (un chemin relatif est refusé) ou « claude » (recherché dans le PATH)
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT_SECONDS=180

# Mode api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=4096

# --- Routage IA ---
# true = si Ollama échoue en mode "auto", on retente sur Claude (envoie le texte au cloud).
AI_ALLOW_CLOUD_FALLBACK=false
# « Structurer avec l'IA » : texte envoyé au plus (premières lignes du document).
AI_MAX_LINES=200
AI_MAX_CHARS=24000

# --- Données locales (conversions, fichiers sources, réglages) ---
DATA_DIR=data
MAX_UPLOAD_MB=50

# --- Conversion ---
CONVERT_MAX_ROWS=200000
CONVERT_MAX_PDF_PAGES=300
CONVERT_PREVIEW_ROWS=200

# --- OCR des relevés scannés et des photos (Tesseract, sur la machine) ---
CONVERT_OCR_ENABLED=true
# Chemin absolu de tesseract si l'app ne le trouve pas (PATH, Homebrew, /usr/local/bin, Program Files\Tesseract-OCR)
CONVERT_OCR_TESSERACT=tesseract
CONVERT_OCR_LANGUAGES=fra+eng
# Dossier des langues (TESSDATA_PREFIX) ; vide = celui de Tesseract
CONVERT_OCR_TESSDATA=
CONVERT_OCR_DPI=300
CONVERT_OCR_MAX_PAGES=50
CONVERT_OCR_TIMEOUT_SECONDS=120

# --- Atelier Tab (docs/SUITE.md §4.4) : dossier de données où « Envoyer dans Atelier Tab » écrit les tables ---
ATELIER_TAB_DATA_DIR=~/Atelier_Tab
